# Spring API 서버 URL
EXPO_PUBLIC_API_URL=http://localhost:8200

# Google OAuth2 Client ID (iOS)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Google OAuth2 Client ID (Android)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Google OAuth2 Client ID (Web, for Expo Go)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Expo Go 전용: 1이면 구글 네이티브 대신 JWT·프로필을 직접 붙여 넣어 로그인(로컬 개발만)
EXPO_PUBLIC_EXPO_GO_DEV_LOGIN=
